{
  "name": "@app/appointmate",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "eas-build-post-install": "cd ../../.. && yarn workspace @vuotto/tokens build && yarn workspace @vuotto/mobile build",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "start": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:android": "eas build --platform android --profile production",
    "build:preview": "eas build --platform android --profile preview",
    "submit:android": "eas submit --platform android",
    "emulators": "firebase emulators:start --only firestore",
    "test:rules": "firebase emulators:exec --only firestore \"jest firestore.rules.test\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@vuotto/mobile": "*",
    "@vuotto/tokens": "*",
    "expo": "~54.0.33",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "firebase": "^11.0.0",
    "react": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@repo/eslint-config": "*",
    "@testing-library/react-native": "^12",
    "@types/node": "^20",
    "@types/react": "~19.1.0",
    "react-test-renderer": "^19",
    "typescript": "~5.9.2"
  },
  "private": true
}
